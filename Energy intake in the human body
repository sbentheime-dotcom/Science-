    </main>

    <div id="copyToast" class="copy-toast fixed bottom-8 left-1/2 -translate-x-1/2 bg-slate-800 text-white px-6 py-3 rounded-full shadow-2xl flex items-center gap-3 z-[100]">
        <i class="fas fa-check-circle text-green-400"></i>
        <span>Question copied to clipboard!</span>
    </div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, onAuthStateChanged, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, setDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Constants & Global State
        const firebaseConfig = JSON.parse(__firebase_config);
        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'nb-student-guide-v2';
        const STORAGE_KEY = `NB_GUIDE_PROGRESS_${appId}`;

        let user = null;
        let selectedQuestions = [];
        let summaryData = {};
        let currentHighestScore = 0;

        const questionsList = [
            "What is the primary function of mitochondria within a cell?",
            "How is the energy captured by plants eventually utilized by the human body?",
            "What are chloroplasts, and how do they relate to the function of mitochondria?",
            "Describe the physical structure of the inner mitochondrial membrane and its functional purpose.",
            "What occurs during the process of cellular respiration?",
            "Identify the specific reactants and products involved in cellular respiration.",
            "Why do muscle cells typically contain a higher concentration of mitochondria than other cell types?",
            "What is the \"symbiotic relationship\" theory regarding the origin of mitochondria?",
            "How does the inheritance of mitochondrial DNA differ from nuclear DNA?",
            "Why is mitochondrial DNA considered a valuable tool for tracking genetic history?"
        ];

        // --- LOCAL STORAGE HELPERS ---
        const getLocalData = () => {
            const data = localStorage.getItem(STORAGE_KEY);
            return data ? JSON.parse(data) : {};
        };

        const updateLocalData = (newFields) => {
            const existing = getLocalData();
            const updated = { ...existing, ...newFields };
            localStorage.setItem(STORAGE_KEY, JSON.stringify(updated));
            return updated;
        };

        // --- PERSISTENCE ---
        const persist = async (newData) => {
            // Save locally first
            updateLocalData(newData);
            
            if (user) {
                const statusEl = document.getElementById('saveStatus');
                statusEl.innerHTML = '<i class="fas fa-sync fa-spin"></i> <span>Syncing...</span>';
                
                try {
                    const docRef = doc(db, 'artifacts', appId, 'users', user.uid, 'progress', 'main');
                    await setDoc(docRef, newData, { merge: true });
                    statusEl.innerHTML = '<i class="fas fa-check-circle text-green-400"></i> <span>Synced</span>';
                } catch (e) {
                    statusEl.innerHTML = '<i class="fas fa-history text-orange-400"></i> <span>Offline</span>';
                }
            }
        };

        const hydrateUIFromData = (data) => {
            if (!data) return;

            // 1. Reflective Inputs
            document.querySelectorAll('.cloud-save').forEach(el => {
                const key = el.getAttribute('data-key');
                if (data[key] !== undefined) el.value = data[key];
            });

            // 2. Score
            if (data.highestScore !== undefined) {
                currentHighestScore = data.highestScore;
                document.getElementById('currentScore').innerText = `${currentHighestScore}%`;
            }

            // 3. Selection & Summaries
            if (data.selectedQuestions) selectedQuestions = data.selectedQuestions;
            if (data.summaryData) summaryData = data.summaryData;

            renderQuestions();
            updateSummarySlots();
        };

        // --- AUTH ---
        const initAuth = async () => {
            hydrateUIFromData(getLocalData());

            if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                await signInWithCustomToken(auth, __initial_auth_token);
            } else {
                await signInAnonymously(auth);
            }
        };

        onAuthStateChanged(auth, (u) => {
            user = u;
            if (user) {
                const docRef = doc(db, 'artifacts', appId, 'users', user.uid, 'progress', 'main');
                onSnapshot(docRef, (snapshot) => {
                    if (snapshot.exists()) {
                        const cloudData = snapshot.data();
                        updateLocalData(cloudData);
                        hydrateUIFromData(cloudData);
                    }
                }, (err) => console.error(err));
            }
        });

        // --- UI HANDLERS ---
        window.renderQuestions = () => {
            const list = document.getElementById('questionList');
            if (!list) return;
            list.innerHTML = '';

            questionsList.forEach((q, index) => {
                const isSelected = selectedQuestions.includes(q);
                const container = document.createElement('div');
                container.className = `relative flex items-stretch rounded-lg border transition-all ${isSelected ? 'question-selected border-indigo-400 shadow-sm' : 'border-slate-200'}`;
                
                const checkBtn = document.createElement('button');
                checkBtn.className = `w-10 flex items-center justify-center border-r transition-colors ${isSelected ? 'bg-indigo-600 text-white border-indigo-600' : 'text-slate-300 border-slate-200'}`;
                checkBtn.innerHTML = `<i class="fas ${isSelected ? 'fa-check-square' : 'fa-square'}"></i>`;
                checkBtn.onclick = () => {
                    if (isSelected) {
                        selectedQuestions = selectedQuestions.filter(item => item !== q);
                    } else if (selectedQuestions.length < 5) {
                        selectedQuestions.push(q);
                    }
                    persist({ selectedQuestions });
                    renderQuestions();
                    updateSummarySlots();
                };

                const copyBtn = document.createElement('button');
                copyBtn.className = "flex-1 text-left p-3 hover:bg-indigo-50/50 transition-colors text-[11px] flex items-start gap-3 group";
                copyBtn.innerHTML = `
                    <span class="text-indigo-400 font-bold">${index + 1}</span>
                    <span class="text-slate-700 flex-1">${q}</span>
                    <i class="fas fa-copy text-slate-200 group-hover:text-indigo-400"></i>
                `;
                copyBtn.onclick = () => {
                    const el = document.createElement('textarea');
                    el.value = q; document.body.appendChild(el); el.select();
                    document.execCommand('copy'); document.body.removeChild(el);
                    const toast = document.getElementById('copyToast');
                    toast.classList.add('show'); setTimeout(() => toast.classList.remove('show'), 2000);
                };

                container.append(checkBtn, copyBtn);
                list.appendChild(container);
            });
            document.getElementById('selectionCount').innerText = selectedQuestions.length;
        };

        window.updateSummarySlots = () => {
            const container = document.getElementById('summaryContainer');
            if (!container) return;

            if (selectedQuestions.length === 0) {
                container.innerHTML = `<div class="lg:col-span-2 py-10 text-center border-2 border-dashed border-slate-100 rounded-xl text-slate-400 text-xs italic">Select 5 questions to generate summary fields.</div>`;
                return;
            }

            container.innerHTML = '';
            selectedQuestions.forEach((q, index) => {
                const slot = document.createElement('div');
                slot.className = "space-y-1";
                slot.innerHTML = `
                    <div class="flex justify-between items-center">
                        <label class="text-[9px] font-bold text-indigo-500 uppercase tracking-tighter">Question Slot ${index + 1}</label>
                    </div>
                    <div class="p-2 bg-slate-50 border border-slate-200 rounded-t-lg text-[10px] text-slate-500 italic border-b-0 leading-tight">"${q}"</div>
                    <textarea class="summary-field w-full p-3 rounded-b-xl border-2 border-slate-100 focus:border-indigo-400 outline-none h-24 text-sm" placeholder="Summarize findings...">${summaryData[q] || ''}</textarea>
                `;
                
                const textarea = slot.querySelector('textarea');
                textarea.oninput = (e) => {
                    summaryData[q] = e.target.value;
                    debounceSave('sum_sync', () => persist({ summaryData }));
                };
                container.appendChild(slot);
            });
        };

        window.updateScore = () => {
            const input = document.getElementById('scoreInput');
            const val = parseInt(input.value);
            if (!isNaN(val) && val >= 0 && val <= 100) {
                if (val > currentHighestScore) {
                    currentHighestScore = val;
                    persist({ highestScore: val });
                    document.getElementById('currentScore').innerText = `${val}%`;
                }
            }
            input.value = '';
        };

        // Event delegation for static text inputs
        document.querySelectorAll('.cloud-save').forEach(el => {
            el.oninput = (e) => {
                const key = e.target.getAttribute('data-key');
                const val = e.target.value;
                debounceSave(key, () => persist({ [key]: val }));
            };
        });

        let timers = {};
        const debounceSave = (id, fn) => {
            clearTimeout(timers[id]);
            timers[id] = setTimeout(fn, 800);
        };

        initAuth();
    </script>
</body>
</html>
