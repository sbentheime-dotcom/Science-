        </section>

        <!-- SECTION 2: CHAT INTERACTION -->
        <section id="section2" class="space-y-6">
            <div class="flex items-center gap-3 border-b-2 border-indigo-100 pb-2">
                <span class="bg-indigo-600 text-white w-8 h-8 rounded-full flex items-center justify-center font-bold">2</span>
                <h2 class="text-2xl font-bold text-indigo-900">The Power of Inquiry</h2>
            </div>
            
            <div class="bg-white p-8 rounded-xl shadow-sm border border-slate-200">
                <div class="mb-8 p-6 bg-indigo-50 rounded-xl border-2 border-indigo-100 flex flex-col md:flex-row items-center justify-between gap-4">
                    <div class="text-center md:text-left">
                        <h3 class="text-lg font-bold text-indigo-900">Access Your Source Notebook</h3>
                        <p class="text-sm text-indigo-700">Visit the curated notebook to start your chat-based inquiry.</p>
                    </div>
                    <a href="https://notebooklm.google.com/notebook/4200cd1d-7f86-4464-9a3d-a47957e0d572?authuser=1" target="_blank" class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-6 rounded-lg shadow-md transition-all">
                        <i class="fas fa-external-link-alt"></i> Mitochondria: Powerhouse & Pedigree
                    </a>
                </div>

                <div class="mb-8">
                    <div class="flex justify-between items-end mb-4">
                        <div>
                            <h3 class="text-lg font-semibold text-slate-700">Step 1: Select 5 Questions</h3>
                            <p class="text-slate-500 text-sm">Check the boxes of the questions you plan to ask. Click a question to copy it.</p>
                        </div>
                        <div class="text-xs font-bold text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full shadow-inner">Selected: <span id="selectionCount">0</span>/5</div>
                    </div>
                    <div class="grid md:grid-cols-2 gap-3" id="questionList"></div>
                </div>

                <div class="pt-6 border-t border-slate-100">
                    <h3 class="text-lg font-semibold text-slate-700 mb-2">Step 2: Summarize Your Findings</h3>
                    <div class="grid lg:grid-cols-2 gap-6" id="summaryContainer"></div>
                </div>
            </div>
        </section>

        <!-- SECTION 3: MASTERY CHECK -->
        <section id="section3" class="space-y-6 pb-20">
            <div class="flex items-center gap-3 border-b-2 border-indigo-100 pb-2">
                <span class="bg-indigo-600 text-white w-8 h-8 rounded-full flex items-center justify-center font-bold">3</span>
                <h2 class="text-2xl font-bold text-indigo-900">Mastery Check</h2>
            </div>
            
            <div class="bg-indigo-900 text-white p-8 rounded-xl shadow-lg relative overflow-hidden">
                <div class="relative z-10">
                    <h3 class="text-xl font-bold mb-2">NotebookLM Studio Quiz</h3>
                    <p class="text-indigo-200 mb-4">Take the quiz in NotebookLM and log your highest score below.</p>
                    <div class="bg-white/10 p-6 rounded-lg backdrop-blur-sm border border-white/20">
                        <div class="flex flex-col md:flex-row items-center gap-8">
                            <div class="text-center">
                                <span class="text-sm uppercase tracking-widest text-indigo-300">Highest Score</span>
                                <div class="text-6xl font-black" id="currentScore">0%</div>
                            </div>
                            <div class="flex-1 space-y-4 w-full">
                                <label class="block text-sm font-medium">Log attempt:</label>
                                <div class="flex gap-2">
                                    <input type="number" id="scoreInput" min="0" max="100" class="flex-1 p-3 rounded bg-white text-slate-900 outline-none focus:ring-4 focus:ring-indigo-400" placeholder="Score %">
                                    <button onclick="updateScore()" class="bg-green-500 hover:bg-green-400 px-6 py-3 rounded font-bold transition-colors">Log</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
